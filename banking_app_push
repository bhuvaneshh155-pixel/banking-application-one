def banking_app_push_1():
    
    balance = 0.0
    
    print("--- Simple Banking Application (Push 1) ---")
    
    
    while True:
        print("\nMain Menu:")
        print("1. Check Balance")
        print("2. Deposit Money")
        print("4. Exit Application") 
        
        choice = input("Select an option: ").strip()
        
        
        if choice == '1':
            print(f"\nYour current balance is: ${balance:,.2f}")
            
        
        elif choice == '2':
            try:
                deposit_amount = float(input("\nEnter the amount to deposit: $"))
                if deposit_amount <= 0:
                    print("Invalid amount. Deposit must be greater than zero.")
                else:
                    balance += deposit_amount
                    print(f"Successfully deposited ${deposit_amount:,.2f}.")
            except ValueError:
                print("Invalid input. Please enter a valid number.")
                
        
        elif choice == '4':
            print("\nGoodbye!")
            break
        else:
            print("Invalid selection. Try again.")

if __name__ == "__main__":
    banking_app_push_1()
